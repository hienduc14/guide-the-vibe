# Copy to docker/.env
# Projects are created in the dashboard (or: gtv project add). Local bare repos are mounted at /repos.
# Optional single-repo bootstrap:
# GTV_REPO_URL=https://x-access-token:<token>@github.com/<org>/<repo>.git
# Protects the dashboard (/api). Empty + no developers = open dev mode.
GTV_ADMIN_TOKEN=change-me-admin
# dev:token pairs; leave empty for open dev mode (X-Gtv-Dev header)
GTV_TOKENS=
GTV_BRAIN_TOKEN=change-me-brain-token
OPENCODE_SERVER_PASSWORD=change-me-opencode
BRAIN_BACKEND=opencode
# provider/model as listed by `opencode models` after login, e.g. openai/gpt-5.1-codex-mini
BRAIN_MODEL=
