# Copy to docker/.env
# Projects are created in the dashboard (or: gtv project add). Local bare repos are mounted at /repos.
# Optional single-repo bootstrap:
# GTV_REPO_URL=https://x-access-token:<token>@github.com/<org>/<repo>.git
# Required (compose refuses to start without it). Generate with: openssl rand -hex 32
GTV_ADMIN_TOKEN=
# dev:token pairs (or issue tokens in the dashboard)
GTV_TOKENS=

# Brain (Pi agent loop inside the Operator). BRAIN_BACKEND=null turns it off.
BRAIN_BACKEND=pi
# Either any OpenAI-compatible endpoint (CLIProxyAPI, OpenRouter, LiteLLM, vLLM, Ollama…) with a bare model id:
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_MODEL=
# BRAIN_API=anthropic-messages   # if BRAIN_BASE_URL speaks the Anthropic API instead
# …or one of Pi's built-in providers: BRAIN_MODEL=anthropic/<model>, openai/<model>, openrouter/<vendor>/<model>,
# google/<model>, with that provider's key:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
