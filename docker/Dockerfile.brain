# Operator brain: Hermes Agent gateway with its OpenAI-compatible API server (log in once with a ChatGPT
# plan, see docs/operations.md). The image seeds $HERMES_HOME/config.yaml from cli-config.yaml.example on
# first boot (docker/stage2-hook.sh in hermes-agent), so our config goes there.
FROM nousresearch/hermes-agent:v0.22.2
COPY docker/hermes/config.yaml /opt/hermes/cli-config.yaml.example
EXPOSE 8642
CMD ["gateway", "run"]
