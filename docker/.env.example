# Copy to docker/.env
# Projects are created in the dashboard (or: gtv project add). Local bare repos are mounted at /repos.
# Optional single-repo bootstrap:
# GTV_REPO_URL=https://x-access-token:<token>@github.com/<org>/<repo>.git
# Required (compose refuses to start without them). Generate each with: openssl rand -hex 32
GTV_ADMIN_TOKEN=
GTV_BRAIN_TOKEN=
HERMES_API_KEY=
# dev:token pairs (or issue tokens in the dashboard)
GTV_TOKENS=
BRAIN_BACKEND=hermes
# provider/model, e.g. openai-codex/gpt-6-luna; empty = default in docker/hermes/config.yaml. The dashboard can change it.
BRAIN_MODEL=
